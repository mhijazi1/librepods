# Copy to hwtest/hwtest.env (gitignored) and fill in. Never commit device addresses.

# The AirPods' Bluetooth address.
AIRPODS=00:00:00:00:00:00

# The second Apple host: a Mac reachable over SSH (key auth) as the user logged in to its GUI session,
# with Music.app holding a track named $MAC_TRACK (create one with `hwtest/run.sh mac-setup`).
MAC_SSH=user@mac.local
MAC_TRACK=airpods-test

# The wired output Linux falls back to (pactl list sinks short).
DAC_SINK=alsa_output.usb-example.analog-stereo

# The MPRIS player used for Linux playback (playerctl -l). Keep a music tab/track ready in it.
PLAYER=firefox

# Where runs are written (default: hwtest/out, gitignored).
#OUT_ROOT=
